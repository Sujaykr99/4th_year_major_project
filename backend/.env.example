# Environment Variables for Career Matrix API

# App Settings
APP_NAME=Career Matrix API
APP_VERSION=1.0.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=career_matrix

# Security Settings
SECRET_KEY=your-super-secret-key-change-in-production-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# ML Model paths (Stack Overflow Model)
MODEL_PATH="ml/saved_models/so_career_model.pkl"
SCALER_PATH="ml/saved_models/so_scaler.pkl"
ENCODERS_PATH="ml/saved_models/so_encoders.pkl"
SHAP_EXPLAINER_PATH="ml/saved_models/so_shap_explainer.pkl"

# Dataset
DATASET_PATH="data/survey_results_public.csv" # Stack Overflow 2024 dataset

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
